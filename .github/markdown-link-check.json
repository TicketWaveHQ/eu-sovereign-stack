{
  "ignorePatterns": [
    { "pattern": "^https://your-domain.example" }
  ],
  "httpHeaders": [
    {
      "urls": ["https://"],
      "headers": {
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check; +https://github.com/sansware/eu-sovereign-stack)",
        "Accept": "text/html,application/xhtml+xml"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "aliveStatusCodes": [200, 206, 301, 302, 307, 308, 403, 429]
}
